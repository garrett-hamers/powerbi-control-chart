# Keep the checked-in submission assets byte-stable across platforms so the deterministic
# audits in scripts/audit-submission-assets.mjs and scripts/certification-audit.mjs cannot
# drift because of line-ending translation.
*.png binary
*.pbiviz binary
*.pbix binary
# Text inputs to the PBIVIZ package and the brand-asset generator must be byte-identical on
# every platform, otherwise the built package is only reproducible per operating system.
*.svg text eol=lf
*.less text eol=lf
*.resjson text eol=lf
# The sample report project is generated byte-for-byte by scripts/build-sample-report.mjs
# and diffed by the submission audit, so it must not be re-encoded on checkout.
samples/** text eol=lf
samples/**/CustomVisuals/** -text
